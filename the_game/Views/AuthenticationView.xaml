<rxui:ReactiveUserControl x:Class="the_game.Views.AuthenticationView" x:TypeArguments="viewModels:AuthenticationViewModel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:rxui="http://reactiveui.net" xmlns:viewModels="clr-namespace:the_game.ViewModels">
 <Grid Background="#10141B"><Border Width="560" Padding="48" Background="#CC1C222D" CornerRadius="12"><StackPanel>
  <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}"/>
  <TextBox Margin="0,28,0,8" Padding="12" FontSize="20" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>
  <PasswordBox x:Name="PasswordInput" Margin="0,8" Padding="12" FontSize="20" PasswordChanged="OnPasswordChanged"/>
  <PasswordBox x:Name="ConfirmationInput" Margin="0,8" Padding="12" FontSize="20" PasswordChanged="OnConfirmationChanged">
   <PasswordBox.Style><Style TargetType="PasswordBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsRegistration}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></PasswordBox.Style>
  </PasswordBox>
  <TextBlock Margin="0,10" Text="{Binding Message}" Foreground="#FFE57373" TextWrapping="Wrap"/>
  <Button Content="ПРОДОЛЖИТЬ" Command="{Binding SubmitCommand}" Style="{StaticResource MenuButtonStyle}"/>
  <Button Content="СМЕНИТЬ РЕЖИМ" Command="{Binding ToggleModeCommand}" Style="{StaticResource MenuButtonStyle}"/>
  <Button Content="НАЗАД" Command="{Binding BackCommand}" Style="{StaticResource MenuButtonStyle}"/>
 </StackPanel></Border></Grid>
</rxui:ReactiveUserControl>
