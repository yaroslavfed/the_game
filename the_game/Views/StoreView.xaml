<rxui:ReactiveUserControl x:Class="the_game.Views.StoreView" x:TypeArguments="viewModels:StoreViewModel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:rxui="http://reactiveui.net" xmlns:viewModels="clr-namespace:the_game.ViewModels" Loaded="OnLoaded">
 <Grid Background="#10141B" Margin="48"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
  <StackPanel><TextBlock Text="МАГАЗИН" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="{Binding Player.Money, StringFormat=Баланс: {0}}" Foreground="White" FontSize="26" Margin="0,12"/><ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Background="#FF1C222D" Foreground="White" FontSize="20"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="8"><TextBlock Text="{Binding Id}" Width="90"/><TextBlock Text="{Binding Kind}" Width="120"/><TextBlock Text="{Binding Price, StringFormat={}{0} $}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
  <Border Grid.Column="1" Margin="32,0,0,0" Padding="36" Background="#CC1C222D" CornerRadius="12"><StackPanel><TextBlock Text="{Binding SelectedItem.Id}" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="{Binding SelectedItem.Power, StringFormat=Сила: {0}}" Foreground="White" FontSize="24" Margin="0,20"/><TextBlock Text="{Binding SelectedItem.Rarity, StringFormat=Редкость: {0}}" Foreground="White" FontSize="24"/><TextBlock Text="{Binding Message}" Foreground="#FFE6C76B" Margin="0,20"/><Button Content="КУПИТЬ" Command="{Binding BuyCommand}" Style="{StaticResource MenuButtonStyle}"/><Button Content="ЭКИПИРОВАТЬ" Command="{Binding EquipCommand}" Style="{StaticResource MenuButtonStyle}"/><Button Content="НАЗАД" Command="{Binding BackCommand}" Style="{StaticResource MenuButtonStyle}"/></StackPanel></Border>
 </Grid>
</rxui:ReactiveUserControl>
