<rxui:ReactiveUserControl x:Class="the_game.Views.SplashView"
        x:TypeArguments="viewModels:SplashViewModel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rxui="http://reactiveui.net"
        xmlns:viewModels="clr-namespace:the_game.ViewModels"
        Focusable="True"
        Loaded="OnLoaded">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding ContinueCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <MediaElement x:Name="BackgroundMedia"
                      LoadedBehavior="Manual"
                      Stretch="UniformToFill"
                      MediaEnded="OnMediaEnded" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="283*" />
                <RowDefinition Height="87*" />
                <RowDefinition Height="72*" />
            </Grid.RowDefinitions>

            <Label Grid.Row="1"
                   Content="PRESS ENTER KEY"
                   Foreground="#FFB3B3B3"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"
                   FontSize="40"
                   FontFamily="Bahnschrift"
                   FontWeight="Bold" />
        </Grid>
    </Grid>
</rxui:ReactiveUserControl>
