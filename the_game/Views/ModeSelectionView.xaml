<rxui:ReactiveUserControl x:Class="the_game.Views.ModeSelectionView"
    x:TypeArguments="viewModels:ModeSelectionViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rxui="http://reactiveui.net"
    xmlns:viewModels="clr-namespace:the_game.ViewModels">
    <Grid Background="#10141B">
        <Border Margin="96" Padding="56" Background="#CC1C222D" CornerRadius="12">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="ВЫБОР РЕЖИМА" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Одиночный бой" Foreground="White" FontSize="30" Margin="0,32,0,8"/>
                <TextBlock Text="Победите всех противников одной волны"
                           Foreground="#FFADB5C0" FontSize="18" Margin="0,0,0,24"/>
                <Button Content="НАЧАТЬ"
                        Command="{Binding StartSinglePlayerCommand}"
                        Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="НАЗАД"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource MenuButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</rxui:ReactiveUserControl>
