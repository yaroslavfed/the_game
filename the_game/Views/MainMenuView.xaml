<rxui:ReactiveUserControl x:Class="the_game.Views.MainMenuView"
        x:TypeArguments="viewModels:MainMenuViewModel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rxui="http://reactiveui.net"
        xmlns:viewModels="clr-namespace:the_game.ViewModels">
    <Grid Background="#10141B">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border Margin="64" Padding="48" Background="#CC1C222D" CornerRadius="12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="THE GAME"
                           Margin="0,0,0,48"
                           Foreground="#FFE3E7EC"
                           FontFamily="Bahnschrift"
                           FontSize="64"
                           FontWeight="Bold" />

                <Button Content="ИГРАТЬ" Command="{Binding PlayCommand}" Style="{StaticResource MenuButtonStyle}" />
                <Button Content="НАСТРОЙКИ" Command="{Binding SettingsCommand}" Style="{StaticResource MenuButtonStyle}" />
                <Button Content="О НАС" Command="{Binding AboutCommand}" Style="{StaticResource MenuButtonStyle}" />
                <Button Content="ВЫХОД" Command="{Binding ExitCommand}" Style="{StaticResource MenuButtonStyle}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Column="1"
                   Margin="48"
                   Text="MVVM REMASTER"
                   Foreground="#30465F"
                   FontFamily="Bahnschrift"
                   FontSize="72"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Grid>
</rxui:ReactiveUserControl>
