<rxui:ReactiveUserControl x:Class="the_game.Views.AboutView"
        x:TypeArguments="viewModels:AboutViewModel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rxui="http://reactiveui.net"
        xmlns:viewModels="clr-namespace:the_game.ViewModels">
    <Grid Background="#10141B">
        <Border Width="720" Padding="48" Background="#CC1C222D" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="О НАС" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Margin="0,24,0,36"
                           Text="The Game — учебный WPF-проект, который проходит полный архитектурный remaster: ReactiveUI, dependency injection, асинхронные сервисы и единая навигационная оболочка."
                           TextWrapping="Wrap"
                           Foreground="#FFB3B3B3"
                           FontSize="20"
                           LineHeight="30" />
                <Button Content="НАЗАД" Command="{Binding BackCommand}" Style="{StaticResource MenuButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</rxui:ReactiveUserControl>
